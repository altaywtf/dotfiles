# Bootstrap and runtime tools
brew "git"
brew "mise"
brew "tmux"

# Called by fixed path from privileged flows (sudo askpass, Xcode selection),
# so they stay under the root-controlled prefix rather than a user shim.
brew "age"
brew "sops"
brew "xcodes"

# Homebrew discovers gh through opt/gh/bin after filtering PATH. Mise retains
# the pinned cross-platform CLI for interactive use.
brew "gh"

# Development CLI
brew "watchman"

# Platform development
cask "android-commandlinetools"

# Media helpers
brew "ffmpeg"
brew "webp"

# Containers
brew "colima"
brew "docker"
brew "docker-buildx"
brew "docker-compose"
brew "docker-credential-helper"

# Security
brew "lynis"
