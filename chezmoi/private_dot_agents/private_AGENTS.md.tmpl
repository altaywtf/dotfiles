{{- $sharedRulesPath := .agentRulesPath -}}
{{- $sharedRules := trim (include $sharedRulesPath) -}}
{{- if eq $sharedRules "" -}}
{{- fail (printf "%s must not be empty" $sharedRulesPath) -}}
{{- end -}}
{{- $privateStartPath := joinPath .chezmoi.homeDir ".config/dotfiles/agents.start.md" -}}
{{- $privateStartLink := lstat $privateStartPath -}}
{{- $privateStartFile := stat $privateStartPath -}}
{{- $privateStart := "" -}}
{{- if and $privateStartLink (not $privateStartFile) -}}
{{- fail (printf "%s is a broken link" $privateStartPath) -}}
{{- end -}}
{{- if $privateStartFile -}}
{{- if ne $privateStartFile.type "file" -}}
{{- fail (printf "%s must resolve to a regular file" $privateStartPath) -}}
{{- end -}}
{{- $privateStart = trim (include $privateStartPath) -}}
{{- end -}}
{{- $privateEndPath := joinPath .chezmoi.homeDir ".config/dotfiles/agents.end.md" -}}
{{- $privateEndLink := lstat $privateEndPath -}}
{{- $privateEndFile := stat $privateEndPath -}}
{{- $privateEnd := "" -}}
{{- if and $privateEndLink (not $privateEndFile) -}}
{{- fail (printf "%s is a broken link" $privateEndPath) -}}
{{- end -}}
{{- if $privateEndFile -}}
{{- if ne $privateEndFile.type "file" -}}
{{- fail (printf "%s must resolve to a regular file" $privateEndPath) -}}
{{- end -}}
{{- $privateEnd = trim (include $privateEndPath) -}}
{{- end -}}
{{- if ne $privateStart "" -}}
{{ $privateStart }}

{{ end -}}
{{ $sharedRules }}
{{- if ne $privateEnd "" }}

{{ $privateEnd }}
{{- end -}}
{{ "\n" -}}
