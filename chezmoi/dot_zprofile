# Login shell bootstrap. macOS path_helper has already run before this file.

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

typeset -U path PATH

# User binaries must be available to login and non-interactive shells, not only
# interactive .zshrc sessions. Agent harnesses inherit this login-shell PATH.
path+=("$HOME/.local/bin")

# Add mise shims for non-interactive login shells. Interactive shells activate
# fully near the end of .zshrc after PATH edits, which also fronts the shims.
if [[ ! -o interactive ]] && command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh --shims)"
  # A nested login shell from a mise-active parent inherits the shim directory
  # in PATH, so activate emits no update while brew shellenv has moved ahead of
  # it. Re-front the shims so mise-selected tools keep precedence.
  mise_shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
  path=("$mise_shims" ${path:#$mise_shims})
  unset mise_shims
fi

# Keep an explicitly installed Octopool shim ahead of mise after login PATH edits.
octopool_shim_dir="${XDG_DATA_HOME:-$HOME/.local/share}/octopool/bin"
if [ -n "${OCTOPOOL_GH_PATH:-}" ] && [ -x "$octopool_shim_dir/gh" ]; then
  path=("$octopool_shim_dir" ${path:#$octopool_shim_dir})
fi
unset octopool_shim_dir
