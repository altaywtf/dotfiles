{{- $profile := includeTemplate "profile" . | fromJson }}
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"
plugins=(git)
# ./dotfiles maintain updates the checkout; the built-in updater stays quiet.
zstyle ':omz:update' mode disabled

{{ if $profile.capabilities.devbox -}}
DISABLE_AUTO_TITLE="true"
{{ end -}}

# oh-my-zsh runs compinit and rebuilds its dump whenever fpath differs from the
# last shell's, so Homebrew completions join fpath first in every shell kind.
typeset -U fpath FPATH
if [ -d /opt/homebrew/share/zsh/site-functions ]; then
  fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
fi

if [ -f "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
fi

{{ if $profile.capabilities.devbox -}}
# A devbox is reached over SSH, so the prompt names the user and host and the
# terminal title follows the working directory.
setopt prompt_subst

devbox_git_prompt_info() {
  local branch dirty

  branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" || return
  [ -n "$branch" ] || return

  if ! git diff --quiet --ignore-submodules -- 2>/dev/null ||
     ! git diff --cached --quiet --ignore-submodules -- 2>/dev/null; then
    dirty='%F{yellow}✗%f'
  fi

  print -n " %F{blue}git:(%F{red}${branch}%F{blue})%f${dirty}"
}

PROMPT='%(?:%F{green}➜%f :%F{red}➜%f )%F{cyan}%n@%m%f %F{green}%~%f$(devbox_git_prompt_info) '

devbox_ssh_prompt_title() {
  print -Pn "\e]0;%m:%~\a"
}
if (( ${precmd_functions[(Ie)devbox_ssh_prompt_title]:-0} == 0 )); then
  precmd_functions+=(devbox_ssh_prompt_title)
fi
{{ end -}}

export EDITOR="vim"
export VISUAL="vim"

# SSH does not forward COLORTERM unless the server explicitly accepts it.
# Keep truecolor TUIs consistent when using Ghostty or another truecolor term.
if [ -n "$TERM" ] && [ -z "$COLORTERM" ]; then
  case "$TERM" in
    *-ghostty|*-direct|*-truecolor|*-24bit|xterm-256color|tmux-256color)
      export COLORTERM="truecolor"
      ;;
  esac
fi

# Login shells already ran brew shellenv in .zprofile.
if [[ ! -o login ]] && [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

typeset -U path PATH

# brew shellenv re-fronts Homebrew ahead of the login-shell mise shims,
# and interactive command shells (zsh -ic) never fire the activation hook that
# would repair PATH. Keep the shims ahead of Homebrew.
if command -v mise >/dev/null 2>&1; then
  mise_shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
  path=("$mise_shims" ${path:#$mise_shims})
  unset mise_shims
fi

path+=("$HOME/.local/bin")

# Prefer a user Android SDK when present. Otherwise use Homebrew command-line tools.
if [ -d "$HOME/Library/Android/sdk" ]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
elif [ -d "$HOME/Android/Sdk" ]; then
  export ANDROID_HOME="$HOME/Android/Sdk"
elif [ -d /opt/homebrew/share/android-commandlinetools ]; then
  export ANDROID_HOME="/opt/homebrew/share/android-commandlinetools"
fi

if [ -n "${ANDROID_HOME:-}" ]; then
  path=(
    "$ANDROID_HOME/platform-tools"
    "$ANDROID_HOME/emulator"
    "$ANDROID_HOME/cmdline-tools/latest/bin"
    $path
  )
fi

typeset -U path PATH

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
else
  echo "mise not found; see docs/bootstrap.md" >&2
fi

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
else
  echo "direnv not found; run ./dotfiles apply" >&2
fi

# The updater rewrites this receipt whenever a run starts or finishes, so an old
# receipt means scheduled runs stopped before they could report anything, unless
# maintenance:disable stopped them on purpose.
dotfiles_update_receipt=("$HOME"/.local/state/dotfiles/updates/software-update.json(N.mm+780))
if (( $#dotfiles_update_receipt )) && [[ ! -e "$HOME/.local/state/dotfiles/updates/software-update.disabled" ]]; then
  echo "dotfiles: no software update has run for 13 hours; see mise run maintenance:status" >&2
fi
unset dotfiles_update_receipt
