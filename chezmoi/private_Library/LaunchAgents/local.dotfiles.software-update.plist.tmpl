{{ $topgrade := printf "%s/.local/share/mise/shims/topgrade" (.chezmoi.homeDir | html) -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>local.dotfiles.software-update</string>
    <key>Disabled</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
      <!-- macOS App Management keys on the executing binary's code signature. The
           mise shim is the ad-hoc signed mise binary, so every mise release became a
           new TCC entry. The real Node binary carries a stable Developer ID. -->
      <string>{{ .chezmoi.homeDir | html }}/.local/share/mise/installs/node/latest/bin/node</string>
      <string>{{ .chezmoi.sourceDir | dir | html }}/maintenance/run.ts</string>
      <string>software-update</string>
      <string>--</string>
      <string>{{ $topgrade }}</string>
      <string>--config</string>
      <string>{{ .chezmoi.homeDir | html }}/.config/topgrade.toml</string>
      <string>--no-tmux</string>
      <string>--no-ask-retry</string>
      <string>--no-self-update</string>
      <string>--notify-end</string>
      <string>on_failure</string>
      <string>--yes</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{ .chezmoi.homeDir | html }}</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>{{ .chezmoi.homeDir | html }}/.local/share/mise/shims:{{ .chezmoi.homeDir | html }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>HOMEBREW_NO_UPGRADE_QUIT_CASKS</key>
      <string>1</string>
      <key>HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS</key>
      <string>1</string>
      <key>HOMEBREW_NO_INSTALL_CLEANUP</key>
      <string>1</string>
      <key>GIT_TERMINAL_PROMPT</key>
      <string>0</string>
      <key>NO_COLOR</key>
      <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <array>
{{ range $hour := list 0 6 12 18 }}
      <dict>
        <key>Hour</key>
        <integer>{{ $hour }}</integer>
        <key>Minute</key>
        <integer>0</integer>
      </dict>
{{ end }}
    </array>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir | html }}/Library/Logs/dotfiles/software-update.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir | html }}/Library/Logs/dotfiles/software-update.log</string>
  </dict>
</plist>
