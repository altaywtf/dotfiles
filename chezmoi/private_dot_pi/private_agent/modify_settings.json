{{- /* chezmoi:modify-template */ -}}
{{- $settings := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
{{- $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $before := toJson $settings -}}
{{- $managed := "npm:pi-claude-marketplace@0.23.0" -}}
{{- $packages := list -}}
{{- range (get $settings "packages" | default list) -}}
{{- $source := . -}}
{{- if kindIs "map" . -}}
{{- $source = get . "source" -}}
{{- end -}}
{{- if not (hasPrefix "npm:pi-claude-marketplace" (toString $source)) -}}
{{- $packages = append $packages . -}}
{{- end -}}
{{- end -}}
{{- $settings = set $settings "packages" (append $packages $managed) -}}
{{ if eq (toJson $settings) $before }}{{ .chezmoi.stdin }}{{ else }}{{ $settings | toPrettyJson }}{{ end }}