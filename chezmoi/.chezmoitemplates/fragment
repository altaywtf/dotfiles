{{- /* Prints a machine-local fragment from ~/.config/dotfiles, or nothing when it is absent. */ -}}
{{- $path := . -}}
{{- $link := lstat $path -}}
{{- $file := stat $path -}}
{{- if and $link (not $file) -}}
{{- fail (printf "%s is a broken link" $path) -}}
{{- end -}}
{{- if $file -}}
{{- if ne $file.type "file" -}}
{{- fail (printf "%s must resolve to a regular file" $path) -}}
{{- end -}}
{{- include $path -}}
{{- end -}}
