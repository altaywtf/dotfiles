# Loaded by every zsh process. Keep this tiny and side-effect free.

export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Only login shells run /etc/zprofile's path_helper. Agent harnesses and
# `zsh -c` inherit whatever PATH the parent had; guarantee the system
# directories as the lowest-precedence baseline for every zsh process.
path+=(/usr/local/bin /usr/bin /bin /usr/sbin /sbin)
typeset -U path PATH
export PATH

if [ -r "$HOME/.config/dotfiles/devbox.env" ]; then
  export HOMEBREW_NO_AUTO_UPDATE="1"
fi

op_ssh_agent_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [ -S "$op_ssh_agent_sock" ]; then
  export SSH_AUTH_SOCK="$op_ssh_agent_sock"
fi
unset op_ssh_agent_sock

# Machine-local extras. Symlinks and unusable files are ignored.
zshenv_local_dir="$HOME/.config/dotfiles"
zshenv_local="$zshenv_local_dir/zshenv.local"
if [ ! -L "$zshenv_local_dir" ] && [ ! -L "$zshenv_local" ] \
  && [ -f "$zshenv_local" ] && [ -r "$zshenv_local" ]; then
  source "$zshenv_local"
fi
unset zshenv_local zshenv_local_dir
