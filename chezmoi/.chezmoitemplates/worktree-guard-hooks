{{- /* Returns .hooks with the worktree guard in PreToolUse for personal profiles only. */ -}}
{{- $hooks := .hooks -}}
{{- $profile := includeTemplate "profile" .ctx | fromJson -}}
{{- $guard := joinPath .ctx.chezmoi.homeDir ".local/libexec/dotfiles/worktree-guard.ts" -}}
{{- $kept := list -}}
{{- if hasKey $hooks "PreToolUse" -}}
{{- range $hooks.PreToolUse -}}
{{- if not (contains "libexec/dotfiles/worktree-guard" (toJson .)) -}}
{{- $kept = append $kept . -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if $profile.capabilities.personal -}}
{{- $kept = append $kept (dict "matcher" "Bash" "hooks" (list (dict "type" "command" "command" (printf "node %s" (quote $guard)) "timeout" 10))) -}}
{{- end -}}
{{- if $kept -}}
{{- $_ := set $hooks "PreToolUse" $kept -}}
{{- else -}}
{{- $_ := unset $hooks "PreToolUse" -}}
{{- end -}}
{{- toJson $hooks -}}
