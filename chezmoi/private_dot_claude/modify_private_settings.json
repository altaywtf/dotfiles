{{- /* chezmoi:modify-template */ -}}
{{- $settings := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
{{- $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- /* Claude Code rewrites this file in its own key order; keep its bytes when nothing managed changed. */ -}}
{{- $before := toJson $settings -}}
{{- $hooks := includeTemplate "worktree-guard-hooks" (dict "hooks" (get $settings "hooks" | default dict) "ctx" .) | fromJson -}}
{{- if $hooks -}}
{{- $_ := set $settings "hooks" $hooks -}}
{{- else -}}
{{- $_ := unset $settings "hooks" -}}
{{- end -}}
{{- $managed := $settings | setValueAtPath "model" "claude-opus-5-5[1m]" | setValueAtPath "modelSettings.claude-opus-5-5.effortLevel" "medium" | setValueAtPath "advisorModel" "claude-fable-5-1" | setValueAtPath "effortLevel" "medium" | setValueAtPath "outputStyle" "Concise" | setValueAtPath "permissions.defaultMode" "auto" | setValueAtPath "autoMemoryEnabled" false | setValueAtPath "attribution.commit" "" | setValueAtPath "attribution.pr" "" | setValueAtPath "attribution.sessionUrl" false | setValueAtPath "env.DISABLE_ERROR_REPORTING" "1" | setValueAtPath "env.DISABLE_FEEDBACK_COMMAND" "1" | setValueAtPath "env.CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY" "1" -}}
{{ if eq (toJson $managed) $before }}{{ .chezmoi.stdin }}{{ else }}{{ $managed | toPrettyJson }}{{ end }}
