{{- /* chezmoi:modify-template */ -}}
{{- $settings := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
{{- $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- /* Claude Code rewrites this file in its own key order; keep its bytes when nothing managed changed. */ -}}
{{- $before := toJson $settings -}}
{{- $managed := unset $settings "advisorModel" | setValueAtPath "model" "claude-opus-5-5[1m]" | setValueAtPath "modelSettings.claude-opus-5-5.effortLevel" "medium" | setValueAtPath "effortLevel" "medium" | setValueAtPath "autoCompactWindow" 400000 | setValueAtPath "outputStyle" "Concise" | setValueAtPath "tui" "fullscreen" | setValueAtPath "viewMode" "focus" | setValueAtPath "showTurnDuration" false | setValueAtPath "awaySummaryEnabled" false | setValueAtPath "spinnerTipsEnabled" false | setValueAtPath "permissions.defaultMode" "auto" | setValueAtPath "autoMemoryEnabled" false | setValueAtPath "syncClaudeAiPlugins" false | setValueAtPath "autoMemoryDirectory" "~/.claude/memory" | setValueAtPath "attribution.commit" "" | setValueAtPath "attribution.pr" "" | setValueAtPath "attribution.sessionUrl" false | setValueAtPath "env.DISABLE_ERROR_REPORTING" "1" | setValueAtPath "env.DISABLE_FEEDBACK_COMMAND" "1" | setValueAtPath "env.CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY" "1" -}}
{{- if kindIs "map" (get $managed "enabledPlugins") -}}
{{- range $id, $enabled := $managed.enabledPlugins -}}
{{- if and (eq $enabled true) (not (hasSuffix "@inline" $id)) -}}
{{- $_ := set $managed.enabledPlugins (printf "%s@inline" (index (splitList "@" $id) 0)) false -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $profile := includeTemplate "profile" . | fromJson -}}
{{- if $profile.capabilities.personal -}}
{{- $managed = $managed | setValueAtPath "env.ENABLE_CLAUDEAI_MCP_SERVERS" "false" -}}
{{- else -}}
{{- $_ := unset $managed.env "ENABLE_CLAUDEAI_MCP_SERVERS" -}}
{{- end -}}
{{- $gatewayPath := joinPath .chezmoi.homeDir ".config/dotfiles/gatewai.json" -}}
{{- if and (or $profile.capabilities.workstation $profile.capabilities.devbox) $profile.capabilities.personal (stat $gatewayPath) -}}
{{- $gateway := includeTemplate "fragment" $gatewayPath | fromJson -}}
{{- $managed = $managed | setValueAtPath "apiKeyHelper" $gateway.keyCommand | setValueAtPath "env.ANTHROPIC_BASE_URL" (trimSuffix "/v1" $gateway.baseUrl) -}}
{{- end -}}
{{- $autoMode := includeTemplate "fragment" (joinPath .chezmoi.homeDir ".config/dotfiles/claude-automode.json") -}}
{{- if $autoMode -}}
{{- $managed = $managed | setValueAtPath "autoMode" ($autoMode | fromJson) -}}
{{- end -}}
{{- $local := includeTemplate "fragment" (joinPath .chezmoi.homeDir ".config/dotfiles/claude-settings.json") -}}
{{- if $local -}}
{{- $managed = mergeOverwrite $managed ($local | fromJson) -}}
{{- end -}}
{{ if eq (toJson $managed) $before }}{{ .chezmoi.stdin }}{{ else }}{{ $managed | toPrettyJson }}{{ end }}