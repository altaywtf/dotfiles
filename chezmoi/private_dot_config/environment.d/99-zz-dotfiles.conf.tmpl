# systemd user services (the maintenance timer) do not read shell
# startup files. This gives the user manager the same PATH front as .zprofile:
# mise shims, the dotfiles agent launchers, and ~/.local/bin.
# Sort after the distro 99-environment.conf import so its baseline is preserved.
PATH={{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.local/libexec/dotfiles/bin:{{ .chezmoi.homeDir }}/.local/bin:${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}
