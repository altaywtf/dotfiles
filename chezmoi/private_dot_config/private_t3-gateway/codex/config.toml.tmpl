{{- $gateway := includeTemplate "fragment" (joinPath .chezmoi.homeDir ".config/dotfiles/t3-gateway.json") | fromJson -}}
model_provider = "gateway"

[features]
apps = false

[model_providers.gateway]
name = "Gateway"
base_url = {{ $gateway.baseUrl | toJson }}
wire_api = "responses"
requires_openai_auth = false
supports_websockets = true
http_headers = { "X-OpenAI-Actor-Authorization" = "local-proxy" }

[model_providers.gateway.auth]
command = {{ $gateway.keyCommand | toJson }}
args = []
timeout_ms = 10000
refresh_interval_ms = 0
