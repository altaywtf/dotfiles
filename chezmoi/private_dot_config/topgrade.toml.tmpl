[misc]
# Dotfiles convergence applies declared runtime versions; OS upgrades remain manual.
{{ if ne .chezmoi.os "darwin" -}}
# Linux host provisioning owns its packages.
only = ["github_cli_extensions", "custom_commands"]
{{ else -}}
only = ["brew_formula", "brew_cask", "github_cli_extensions", "custom_commands"]
{{ end -}}
assume_yes = true
ask_retry = false
no_self_update = true
notify_end = "on_failure"

[brew]
# Scheduled jobs set HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS so Homebrew
# leaves self-updating apps to their vendor without quitting running apps.
# greedy_latest still covers `version :latest` casks, which brew must manage.
greedy_latest = true
autoremove = false

{{ if eq .chezmoi.os "darwin" -}}
[pre_commands]
# Developer commands can switch Homebrew from stable tags to its main branch.
"Stable Homebrew" = "brew developer off"

{{ end -}}
{{ if not .temporarySource -}}
# Both commands run from the persistent checkout this profile was applied from.
[commands]
"Managed dotfiles" = {{ printf "node %s/maintenance/converge.ts" (.chezmoi.sourceDir | dir | quote) | toJson }}
"Host hygiene" = {{ printf "node %s/maintenance/hygiene.ts --apply --scheduled" (.chezmoi.sourceDir | dir | quote) | toJson }}
{{ end -}}
