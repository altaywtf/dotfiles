{{ includeTemplate "mise.toml" . }}
{{- /* The per-OS file repeats the [tools] header so Renovate can parse it alone; drop it here. */}}
{{ regexReplaceAll "(?m)^\\[tools\\]\n" (includeTemplate (printf "%s/mise.toml" .chezmoi.os) .) "" }}
{{ includeTemplate "mise-tasks.toml" . }}
[settings]
node.npm_shim = false
idiomatic_version_file_enable_tools = ["java", "rust"]
trusted_config_paths = ["~/.codex/worktrees", "~/.claude/worktrees", "~/.t3/worktrees"]
# Match the shared three-day Renovate gate for runtimes, package managers, and held tools.
minimum_release_age = "3d"
minimum_release_age_excludes = [
  "npm:@openai/codex",
  "npm:@xai-official/grok",
  "npm:t3",
  "gh",
  "jq",
  "ripgrep",
  "shellcheck",
  "actionlint",
  "chezmoi",
  "direnv",
  "gitleaks",
  "trufflehog",
  "topgrade",
  "awscli",
  "glab",
  "git-filter-repo",
  "github:anthropics/claude-code",
  "xcodegen",
  "btop",
  "github:uinaf/ffss",
]

[settings.github]
credential_command = {{ printf "\"%s/.local/libexec/dotfiles/mise-github-token\"" .chezmoi.homeDir | quote }}
