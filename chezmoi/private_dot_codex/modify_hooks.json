{{- /* chezmoi:modify-template */ -}}
{{- $config := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
{{- $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $hooks := includeTemplate "worktree-guard-hooks" (dict "hooks" (get $config "hooks" | default dict) "ctx" .) | fromJson -}}
{{- if $hooks -}}
{{- $_ := set $config "hooks" $hooks -}}
{{- else -}}
{{- $_ := unset $config "hooks" -}}
{{- end -}}
{{- if $config -}}
{{ $config | toPrettyJson }}
{{ end -}}
