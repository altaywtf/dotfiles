{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>altaywtf/.github:renovate-config"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Hold the changelog preset for release-notes-generator 14; newer presets require writer 9 and must be upgraded together",
      "matchPackageNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "10.2.1"
    },
    {
      "description": "Keep CI, bootstrap, and installed Node on the same release",
      "matchPackageNames": ["node"],
      "groupName": "Node.js",
      "rangeStrategy": "bump"
    },
    {
      "description": "Harness and stable CLI patch and minor pins have no release age; every other pin keeps the shared three-day gate",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "npm:@openai/codex",
        "npm:@xai-official/grok",
        "npm:t3",
        "gh",
        "jq",
        "ripgrep",
        "shellcheck",
        "actionlint",
        "chezmoi",
        "direnv",
        "gitleaks",
        "trufflehog",
        "topgrade",
        "awscli",
        "glab",
        "git-filter-repo",
        "github:anthropics/claude-code",
        "xcodegen",
        "btop",
        "github:uinaf/ffss"
      ],
      "matchUpdateTypes": ["patch", "minor", "pin"],
      "minimumReleaseAge": null,
      "schedule": ["at any time"],
      "groupName": "mise CLI patch and minor"
    },
    {
      "description": "Keep repository and installed pnpm together in one push",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Keep PyYAML install and live verification together",
      "matchPackageNames": ["PyYAML"],
      "groupName": "PyYAML"
    },
    {
      "matchManagers": ["mise"],
      "matchPackageNames": ["uinaf/ffss"],
      "extractVersion": "^slopguard/v(?<version>.+)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "npm installed by the mise runtime package task",
      "managerFilePatterns": ["/^chezmoi/\\.chezmoitemplates/mise-tasks\\.toml$/"],
      "matchStrings": ["(?<depName>npm)@(?<currentValue>[0-9][^\\s\"&]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "PyYAML installed into mise Python",
      "managerFilePatterns": ["/^chezmoi/\\.chezmoitemplates/mise-tasks\\.toml$/"],
      "matchStrings": ["(?<depName>PyYAML)==(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Annotated TypeScript dependency constants",
      "managerFilePatterns": ["/^(agents/sync|verify/bootstrap)\\.ts$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+(?:export )?const [A-Z_]+ = \"(?<currentValue>[^\"]+)\";"
      ]
    },
    {
      "customType": "regex",
      "description": "Pinned oh-my-zsh revision, followed as a digest of its default branch",
      "managerFilePatterns": ["/^bootstrap/install-oh-my-zsh\\.ts$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>git-refs) depName=(?<depName>[^\\s]+) branch=(?<currentValue>[^\\s]+)\\s+const OH_MY_ZSH_REVISION = \"(?<currentDigest>[0-9a-f]{40})\";"
      ]
    },
    {
      "customType": "regex",
      "description": "semantic-release action runtime and plugins",
      "managerFilePatterns": ["/^\\.github/workflows/verify\\.yml$/"],
      "matchStrings": ["semantic_version: (?<currentValue>[0-9.]+)"],
      "depNameTemplate": "semantic-release",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Exact semantic-release plugin versions",
      "managerFilePatterns": ["/^\\.github/workflows/verify\\.yml$/"],
      "matchStrings": [
        "\\n +(?<depName>@semantic-release/[a-z-]+|conventional-changelog-conventionalcommits)@(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
