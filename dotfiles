#!/bin/sh
set -eu

repo_root="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
node_version=$(cat "$repo_root/.node-version")
pnpm_version=$(sed -n 's/^  "packageManager": "pnpm@\([^"]*\)",*$/\1/p' "$repo_root/package.json")
if [ -z "$pnpm_version" ]; then
  printf 'FAILED: package.json has no pnpm packageManager pin\n' >&2
  exit 1
fi

if [ "$#" -eq 1 ]; then
  case "$1" in
    -h|--help)
      printf '%s\n' 'Usage: ./dotfiles prepare | maintain | diff|check PROFILE | apply PROFILE [--switch-profile]' \
        'prepare installs repository dependencies; maintain converges the stored profile without retiring logins.'
      exit 0
      ;;
    prepare)
      mise --no-config x "node@$node_version" "pnpm@$pnpm_version" -- pnpm --dir "$repo_root" install --frozen-lockfile
      exit 0
      ;;
    maintain)
      mise --no-config x "node@$node_version" "pnpm@$pnpm_version" -- pnpm --dir "$repo_root" install --frozen-lockfile
      exec mise --no-config x "node@$node_version" -- node "$repo_root/bootstrap/install.ts" --maintenance
      ;;
  esac
fi

if command -v node >/dev/null 2>&1 \
  && (cd "$repo_root" && node -e 'import("effect")' >/dev/null 2>&1); then
  exec node "$repo_root/bootstrap/cli.ts" "$@"
fi

if ! command -v mise >/dev/null 2>&1; then
  printf 'FAILED: mise is required; see docs/bootstrap.md\n' >&2
  exit 1
fi

mise --no-config x "node@$node_version" "pnpm@$pnpm_version" -- pnpm --dir "$repo_root" install --frozen-lockfile
exec mise --no-config x "node@$node_version" "pnpm@$pnpm_version" -- pnpm --dir "$repo_root" exec node "$repo_root/bootstrap/cli.ts" "$@"
